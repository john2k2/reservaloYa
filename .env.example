NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SENTRY_DSN=
# Set NEXT_IMAGE_OPTIMIZED=true only when Vercel image optimization quota is available.
# NEXT_IMAGE_OPTIMIZED=true
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=1.0

SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=

RESEND_API_KEY=
RESEND_FROM_EMAIL=
BOOKING_LINK_SECRET=
BOOKING_LINK_TTL_DAYS=30

# Local development only — NEVER set this in a deployed environment (staging, preview,
# self-hosted). Without it, missing BOOKING_LINK_SECRET/CSRF_SECRET fail closed even
# outside NODE_ENV=production, instead of falling back to a committed dev secret.
ALLOW_DEV_SECRETS=
BOOKING_JOBS_SECRET=
CRON_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_TEMPLATE_SID=

# Panel de plataforma (superadmin)
PLATFORM_SUPERADMIN_EMAIL=

# MercadoPago (pagos online de turnos por negocio via OAuth; cobro SaaS de plataforma opcional/legacy)
# Crear access token en: https://www.mercadopago.com.ar/developers/panel/app
# Usar sandbox para probar: https://sandbox.mercadopago.com
MP_ACCESS_TOKEN=
MP_APP_ID=
MP_APP_SECRET=
MP_WEBHOOK_SECRET=
MP_TOKEN_ENCRYPTION_KEY=

# Polar (cobro de suscripción de plataforma en USD — checkout + webhooks)
# Dashboard: https://polar.sh — producto recurrente USD 22
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_PRODUCT_ID=
# sandbox | production
POLAR_SERVER=sandbox

# Transferencia bancaria (cobro manual ARS de la suscripción de plataforma)
BILLING_TRANSFER_ALIAS=
BILLING_TRANSFER_CBU=
BILLING_TRANSFER_HOLDER=
BILLING_TRANSFER_BANK=

# CSRF protection for subscription payment preference endpoint
CSRF_SECRET=
